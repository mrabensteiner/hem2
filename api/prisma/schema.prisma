// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum projectRole {
  MANAGER
  MEMBER
}

model Role {
  id               String  @id @unique @default(nanoid(8))
  title            String  @default("")
  description      String  @default("")
  order            Int     @default(0)
  userAdd          Boolean @default(false)
  userEdit         Boolean @default(false)
  projectAdd       Boolean @default(false)
  projectViewAll   Boolean @default(false)
  projectEditAll   Boolean @default(false)
  heuristicSetEdit Boolean @default(false)
  ratingSetEdit    Boolean @default(false)
  statusEdit       Boolean @default(false)
  users            User[]
}

model User {
  id            String          @id @unique @default(nanoid(8))
  username      String          @unique
  password      String          @default(nanoid(8))
  email         String          @unique
  firstname     String          @default("")
  lastname      String          @default("")
  image         Image?          @relation(fields: [imageId], references: [id])
  role          Role            @relation(fields: [roleId], references: [id])
  UserInProject UserInProject[]
  Finding       Finding?        @relation(fields: [findingId], references: [id])
  findingId     String?
  imageId       String?
  roleId        String
}

model UserInProject {
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  project     Project     @relation(fields: [projectId], references: [id])
  projectId   String
  projectRole projectRole @default(MEMBER)

  @@id([userId, projectId])
}

model Project {
  id             String          @id @unique @default(nanoid(8))
  status         Status          @relation(fields: [statusId], references: [id])
  title          String          @default("")
  description    String          @default("")
  logo           Image?          @relation(fields: [imageId], references: [id])
  updatedat      DateTime?       @default(now()) @updatedAt
  createdat      DateTime?       @default(now())
  heuristicset   HeuristicSet?   @relation(fields: [heuristicsetId], references: [id])
  severityset    SeveritySet?    @relation(fields: [severitysetId], references: [id])
  statusId       String
  heuristicsetId String?
  severitysetId  String?
  UserInProject  UserInProject[]
  Findings       Finding[]
  imageId        String?
}

model Finding {
  id          String      @id @unique @default(nanoid(10))
  project     Project     @relation(fields: [projectId], references: [id])
  title       String      @default("")
  description String      @default("")
  images      Image[]
  user        User[]
  heuristics  Heuristic[]
  severity    Severity?   @relation(fields: [severityId], references: [id])
  projectId   String
  severityId  String?
  updatedat   DateTime?   @default(now()) @updatedAt
  createdat   DateTime?   @default(now())
}

model Status {
  id                 String    @id @unique @default(nanoid(8))
  title              String    @default("")
  color              String    @default("#aaa")
  textcolor          String    @default("#eee")
  order              Int       @default(0)
  projectViewDetails Boolean   @default(false)
  findingsAdd        Boolean   @default(false)
  findingsViewOwn    Boolean   @default(false)
  findingsViewAll    Boolean   @default(false)
  findingsEditOwn    Boolean   @default(false)
  findingsEditAll    Boolean   @default(false)
  ratingEdit         Boolean   @default(false)
  project            Project[]
}

model HeuristicSet {
  id          String      @id @unique @default(nanoid(8))
  title       String      @default("")
  description String      @default("")
  project     Project[]
  heuristics  Heuristic[]
}

model Heuristic {
  id             String        @id @unique @default(nanoid(8))
  title          String        @default("")
  description    String        @default("")
  set            HeuristicSet? @relation(fields: [heuristicsetId], references: [id])
  color          String        @default("#aaa")
  textcolor      String        @default("#eee")
  heuristicsetId String?
  Finding        Finding[]
  order          Int?
}

model SeveritySet {
  id          String     @id @unique @default(nanoid(8))
  title       String     @default("")
  description String     @default("")
  project     Project[]
  severities  Severity[]
}

model Severity {
  id            String       @id @unique @default(nanoid(8))
  title         String       @default("")
  description   String       @default("")
  set           SeveritySet? @relation(fields: [severitysetId], references: [id])
  color         String?      @default("#aaa")
  textcolor     String?      @default("#eee")
  severitysetId String?
  Finding       Finding[]
  order         Int          @default(0)
}

model Image {
  id        String    @id @unique @default(nanoid(8))
  filename  String
  path      String
  users     User[]
  projects  Project[]
  finding   Finding?  @relation(fields: [findingId], references: [id])
  findingId String?
}
