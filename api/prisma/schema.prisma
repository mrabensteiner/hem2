// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum role {
  ADMIN
  MANAGER
  USER
}

enum projectRole {
  MANAGER
  MEMBER
}

model User {
  id            String          @id @unique @default(nanoid(8))
  username      String          @unique
  password      String          @default(nanoid(8))
  email         String          @unique
  firstname     String?
  lastname      String?
  image         Image?          @relation(fields: [imageId], references: [id])
  role          role            @default(USER)
  UserInProject UserInProject[]
  Finding       Finding?        @relation(fields: [findingId], references: [id])
  findingId     String?
  imageId       String?
}

model UserInProject {
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  project     Project     @relation(fields: [projectId], references: [id])
  projectId   String
  projectRole projectRole @default(MEMBER)

  @@id([userId, projectId])
}

model Project {
  id             String          @id @unique @default(nanoid(8))
  status         Status          @relation(fields: [statusId], references: [id])
  title          String?
  description    String?
  logo           Image?          @relation(fields: [imageId], references: [id])
  updatedat      DateTime?       @default(now()) @updatedAt
  createdat      DateTime?       @default(now())
  heuristicset   HeuristicSet?   @relation(fields: [heuristicsetId], references: [id])
  severityset    SeveritySet?    @relation(fields: [severitysetId], references: [id])
  statusId       String
  heuristicsetId String?
  severitysetId  String?
  UserInProject  UserInProject[]
  Findings       Finding[]
  imageId        String?
}

model Finding {
  id          String      @id @unique @default(nanoid(10))
  project     Project     @relation(fields: [projectId], references: [id])
  title       String?
  description String?
  images      Image[]
  user        User[]
  heuristics  Heuristic[]
  severity    Severity?   @relation(fields: [severityId], references: [id])
  projectId   String
  severityId  String?
  updatedat   DateTime?   @default(now()) @updatedAt
  createdat   DateTime?   @default(now())
}

model Status {
  id        String    @id @unique @default(nanoid(8))
  title     String
  color     String?
  textcolor String?
  project   Project[]
  order     Int?
}

model HeuristicSet {
  id          String      @id @unique @default(nanoid(8))
  title       String?
  description String?
  project     Project[]
  heuristics  Heuristic[]
}

model Heuristic {
  id             String        @id @unique @default(nanoid(8))
  title          String?
  description    String?
  set            HeuristicSet? @relation(fields: [heuristicsetId], references: [id])
  color          String?
  textcolor      String?
  heuristicsetId String?
  Finding        Finding[]
  order          Int?
}

model SeveritySet {
  id          String     @id @unique @default(nanoid(8))
  title       String?
  description String?
  project     Project[]
  severities  Severity[]
}

model Severity {
  id            String       @id @unique @default(nanoid(8))
  title         String?
  description   String?
  set           SeveritySet? @relation(fields: [severitysetId], references: [id])
  color         String?
  textcolor     String?
  severitysetId String?
  Finding       Finding[]
  order         Int?
}

model Image {
  id        String    @id @unique @default(nanoid(8))
  filename  String
  path      String
  users     User[]
  projects  Project[]
  finding   Finding?  @relation(fields: [findingId], references: [id])
  findingId String?
}
