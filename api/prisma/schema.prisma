generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum projectRole {
  MANAGER
  MEMBER
}

model Role {
  id                  String  @id @unique @default(nanoid(8))
  title               String  @default("")
  description         String  @default("")
  order               Int     @default(autoincrement())
  userAdd             Boolean @default(false)
  userEdit            Boolean @default(false)
  projectAdd          Boolean @default(false)
  projectViewAll      Boolean @default(false)
  projectEditAll      Boolean @default(false)
  heuristicSetEditAll Boolean @default(false)
  heuristicSetEditOwn Boolean @default(false)
  ratingSetEditAll    Boolean @default(false)
  ratingSetEditOwn    Boolean @default(false)
  statusEdit          Boolean @default(false)
  roleEdit            Boolean @default(false)
  users               User[]
}

model User {
  id            String          @id @unique @default(nanoid(8))
  username      String          @unique
  password      String          @default(nanoid(8))
  email         String          @unique
  firstname     String          @default("")
  lastname      String          @default("")
  colorScheme   String          @default("system")
  image         Image?
  role          Role            @relation(fields: [roleId], references: [id])
  UserInProject UserInProject[]
  Findings      Finding[]
  roleId        String
  userRatings   UserRating[]
  heuristicSets HeuristicSet[]
  ratingSets    RatingSet[]
}

model UserInProject {
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  project     Project     @relation(fields: [projectId], references: [id])
  projectId   String
  projectRole projectRole @default(MEMBER)

  @@id([userId, projectId, projectRole])
}

model Project {
  id             String          @id @unique @default(nanoid(8))
  status         Status          @relation(fields: [statusId], references: [id])
  title          String          @default("")
  description    String          @default("")
  logo           Image?
  updatedat      DateTime?       @default(now()) @updatedAt
  createdat      DateTime?       @default(now())
  heuristicset   HeuristicSet?   @relation(fields: [heuristicsetId], references: [id])
  ratingset      RatingSet?      @relation(fields: [ratingsetId], references: [id])
  statusId       String
  heuristicsetId String?
  ratingsetId    String?
  UserInProject  UserInProject[]
  Findings       Finding[]
}

model Finding {
  id          String       @id @unique @default(nanoid(10))
  project     Project      @relation(fields: [projectId], references: [id])
  title       String       @default("")
  description String       @default("")
  remarks     String       @default("")
  images      Image[]
  user        User[]
  heuristics  Heuristic[]
  rating      Rating?      @relation(fields: [ratingId], references: [id])
  projectId   String
  ratingId    String?
  updatedat   DateTime?    @default(now()) @updatedAt
  createdat   DateTime?    @default(now())
  userRatings UserRating[]
  reviewed    Boolean      @default(false)
  positive    Boolean      @default(false)
  mergedToId  String?
  mergedTo    Finding?     @relation("merge", fields: [mergedToId], references: [id])
  mergedFrom  Finding[]    @relation("merge")
}

model UserRating {
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  finding   Finding @relation(fields: [findingId], references: [id])
  findingId String
  rating    Rating  @relation(fields: [ratingId], references: [id])
  ratingId  String

  @@id([userId, findingId])
}

model Status {
  id                 String    @id @unique @default(nanoid(8))
  title              String    @default("")
  color              String    @default("#aaa")
  textcolor          String    @default("#222")
  order              Int       @unique @default(autoincrement())
  projectViewDetails Boolean   @default(false)
  findingsAdd        Boolean   @default(false)
  findingsViewOwn    Boolean   @default(false)
  findingsViewAll    Boolean   @default(false)
  findingsEditOwn    Boolean   @default(false)
  findingsEditAll    Boolean   @default(false)
  ratingEdit         Boolean   @default(false)
  project            Project[]
}

model HeuristicSet {
  id          String      @id @unique @default(nanoid(8))
  title       String      @default("")
  description String      @default("")
  project     Project[]
  heuristics  Heuristic[]
  user        User?       @relation(fields: [userId], references: [id])
  userId      String?
}

model Heuristic {
  id             String        @id @unique @default(nanoid(8))
  title          String        @default("")
  description    String        @default("")
  set            HeuristicSet? @relation(fields: [heuristicsetId], references: [id])
  color          String        @default("#aaa")
  textcolor      String        @default("#222")
  heuristicsetId String?
  Finding        Finding[]
  order          Int           @default(autoincrement())
}

model RatingSet {
  id          String    @id @unique @default(nanoid(8))
  title       String    @default("")
  description String    @default("")
  project     Project[]
  ratings     Rating[]
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
}

model Rating {
  id          String       @id @unique @default(nanoid(8))
  title       String       @default("")
  description String       @default("")
  set         RatingSet?   @relation(fields: [ratingsetId], references: [id])
  color       String?      @default("#aaa")
  textcolor   String?      @default("#222")
  ratingsetId String?
  Finding     Finding[]
  order       Int          @default(autoincrement())
  value       Int          @default(0)
  userRatings UserRating[]
}

model Image {
  id        String   @id @unique @default(nanoid(8))
  filename  String
  path      String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @unique
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?  @unique
  findings  Finding[]
}
