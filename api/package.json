{
  "name": "hem2-api",
  "version": "1.0.0",
  "type": "module",
  "keywords": ["heuristic evaluation", "expert review", "issue tracking","ux", "vue", "postgres"],
  "description": "The API part of HEM2, handling HTTP requests and database transactions.",
  "author": "Martin Rabensteiner",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "prisma generate",
    "db:migrate": "prisma migrate dev --name=init",
    "db:setup": "pnpm db:init; pnpm db:migrate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
